{
  "name": "Membership",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "elite"
      ],
      "description": "Membership tier"
    },
    "price_monthly": {
      "type": "number",
      "description": "Monthly price in USD"
    },
    "description": {
      "type": "string",
      "description": "Tier description"
    },
    "features": {
      "type": "array",
      "description": "List of tier features",
      "items": {
        "type": "string"
      }
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe price ID for this tier"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tier",
    "price_monthly"
  ]
}